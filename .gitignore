# Python bytecode cache -- regenerated on run, not source.
__pycache__/
*.pyc

# Local MAME config and screenshots -- machine-specific / transient, made by
# whatever cartridge you last pointed a tool at, not toolkit content.
/cfg/
/snap/

# Any ROM someone drops in to test against -- never distribute a cartridge
# dump from this repo. Every tool here takes a ROM path as an argument; none
# is bundled.
*.a78
*.bin
*.rom
*.car
*.atr
*.atx
*.xex

.DS_Store

# ...except the test cartridge this repo builds from source (tests/synth.py):
# it is ours, deterministic, and the tests compare a fresh build against it.
!tests/carts/*.a78

# ...and MAME's own dump of the RIOT test cartridge's timer, which t_sim_machine compares the
# simulator against (a 4K RAM image, not a cartridge).
!tests/golden/*.bin
